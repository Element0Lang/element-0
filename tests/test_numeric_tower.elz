;;; ---------------------------------------
;;; Element 0 Numeric Tower Test Suite
;;; ---------------------------------------

(display "Running Element 0 numeric tower tests...")
(newline)

(define *tests-run* 0)
(define *tests-failed* 0)

(define (test-case name test-expr)
  (set! *tests-run* (+ *tests-run* 1))
  (if (not (try test-expr (catch err #f)))
      (begin
        (set! *tests-failed* (+ *tests-failed* 1))
        (display "[FAILED]: ") (display name) (newline))
      (begin
        (display "[PASSED]: ") (display name) (newline))))

;; --- Predicates ---
(test-case "number? on int" (number? 3))
(test-case "number? on rational" (number? 1/2))
(test-case "number? on float" (number? 3.0))
(test-case "exact? on int" (exact? 3))
(test-case "exact? on rational" (exact? 1/3))
(test-case "inexact? on float" (inexact? 3.0))
(test-case "integer? on int" (integer? 3))
(test-case "integer? on float-integer" (integer? 3.0))
(test-case "rational? on int" (rational? 3))
(test-case "rational? on rational" (rational? 2/3))
(test-case "real? on float" (real? 3.14))
(test-case "not number? on bool" (not (number? #t)))

;; --- Arithmetic ---
(test-case "1 + 2 = 3 exact" (= (+ 1 2) 3))
(test-case "exact - exact = exact" (= (- 5 2) 3))
(test-case "exact * exact = exact" (= (* 3 4) 12))
(test-case "1/3 is rational" (rational? (/ 1 3)))
(test-case "1/3 + 1/3 = 2/3" (= (+ 1/3 1/3) 2/3))
(test-case "1/2 + 1/2 = 1" (= (+ 1/2 1/2) 1))
(test-case "exact + inexact -> inexact" (inexact? (+ 1 1.0)))
(test-case "mixed 1 + 1.0 = 2.0" (= (+ 1 1.0) 2.0))

;; --- Parser prefixes ---
(test-case "#e3.0 is exact" (exact? #e3.0))
(test-case "#i3 is inexact" (inexact? #i3))
(test-case "#i3 == 3.0" (= #i3 3.0))

;; --- Rational normalization ---
(test-case "2/4 -> 1/2" (= 2/4 1/2))
(test-case "negative denom normalized" (= (/ 1 -2) -1/2))

;; --- Conversion ---
(test-case "exact->inexact 1/2 = 0.5" (= (exact->inexact 1/2) 0.5))
(test-case "inexact->exact 3.0 = 3" (= (inexact->exact 3.0) 3))
(test-case "inexact->exact 3.0 is exact" (exact? (inexact->exact 3.0)))

;; --- Floor/ceil/round on rational ---
(test-case "floor 7/2 = 3" (= (floor 7/2) 3))
(test-case "ceiling 7/2 = 4" (= (ceiling 7/2) 4))
(test-case "truncate -7/2 = -3" (= (truncate -7/2) -3))

;; --- gcd/lcm/quotient/remainder ---
(test-case "gcd 12 18 = 6" (= (gcd 12 18) 6))
(test-case "lcm 4 6 = 12" (= (lcm 4 6) 12))
(test-case "quotient 7 2 = 3" (= (quotient 7 2) 3))
(test-case "remainder 7 2 = 1" (= (remainder 7 2) 1))
(test-case "modulo -7 2 = 1" (= (modulo -7 2) 1))

;; --- sqrt of perfect square is exact ---
(test-case "sqrt 16 is exact 4" (and (exact? (sqrt 16)) (= (sqrt 16) 4)))
(test-case "sqrt 2 is inexact" (inexact? (sqrt 2)))

;; --- abs ---
(test-case "abs -3 = 3" (= (abs -3) 3))
(test-case "abs -3/4 = 3/4" (= (abs -3/4) 3/4))

;; --- Rational accessors ---
(test-case "numerator 3/4" (= (numerator 3/4) 3))
(test-case "denominator 3/4" (= (denominator 3/4) 4))
(test-case "numerator of integer" (= (numerator 5) 5))
(test-case "denominator of integer" (= (denominator 5) 1))
(test-case "denominator of zero" (= (denominator 0) 1))
(test-case "numerator is exact" (exact? (numerator 3/4)))
(test-case "numerator of negative rational" (= (numerator -3/4) -3))
(test-case "denominator of inexact" (= (denominator 0.5) 2.0))
(test-case "denominator of inexact is inexact" (inexact? (denominator 0.5)))

;; --- rationalize ---
(test-case "rationalize 3/10 by 1/10" (= (rationalize 3/10 1/10) 1/3))
(test-case "rationalize exact is exact" (exact? (rationalize 3/10 1/10)))
(test-case "rationalize inexact is inexact" (inexact? (rationalize .3 1/10)))
(test-case "rationalize inexact value" (= (rationalize .3 1/10) (exact->inexact 1/3)))
(test-case "rationalize integer zero tolerance" (= (rationalize 5 0) 5))

;; --- Complex accessors ---
(test-case "make-rectangular is not real" (not (real? (make-rectangular 3 4))))
(test-case "make-rectangular is complex" (complex? (make-rectangular 3 4)))
(test-case "real-part of 3+4i" (= (real-part (make-rectangular 3 4)) 3.0))
(test-case "imag-part of 3+4i" (= (imag-part (make-rectangular 3 4)) 4.0))
(test-case "magnitude of 3+4i" (= (magnitude (make-rectangular 3 4)) 5.0))
(test-case "make-polar on real axis" (< (abs (- (real-part (make-polar 2 0)) 2.0)) 1e-9))
(test-case "angle of i" (< (abs (- (angle (make-rectangular 0 1)) 1.5707963267948966)) 1e-9))
(test-case "real-part of real" (= (real-part 5) 5))
(test-case "imag-part of real is zero" (= (imag-part 5) 0))
(test-case "imag-part of inexact real is exact" (exact? (imag-part 5.0)))
(test-case "magnitude of negative real" (= (magnitude -3) 3))
(test-case "magnitude of rational stays exact" (= (magnitude -3/4) 3/4))
(test-case "angle of negative real" (< (abs (- (angle -1) 3.141592653589793)) 1e-9))
(test-case "angle of positive real is zero" (= (angle 2) 0))

;; --- Summary ---
(newline)
(display "--------------------") (newline)
(display "Tests Finished.") (newline)
(display "Total run: ") (display *tests-run*) (newline)
(display "Passed: ") (display (- *tests-run* *tests-failed*)) (newline)
(display "Failed: ") (display *tests-failed*) (newline)
(newline)
(if (> *tests-failed* 0)
    (display "RESULT: FAILED")
    (display "RESULT: PASSED"))
(newline)

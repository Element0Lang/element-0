;; Tests for escape continuations

(define *tests-run* 0)
(define *tests-failed* 0)

(define (test-case name test-expr)
  (set! *tests-run* (+ *tests-run* 1))
  (if (not (try test-expr (catch err #f)))
      (begin
        (set! *tests-failed* (+ *tests-failed* 1))
        (display "[FAILED]: ") (display name) (newline))
      (begin
        (display "[PASSED]: ") (display name) (newline))))

(define (report-summary)
  (newline)
  (display "--------------------") (newline)
  (display "Tests Finished.") (newline)
  (display "Total run: ") (display *tests-run*) (newline)
  (display "Passed: ") (display (- *tests-run* *tests-failed*)) (newline)
  (display "Failed: ") (display *tests-failed*) (newline)
  (newline)
  (if (= *tests-failed* 0)
      (begin (display "RESULT: PASSED") (newline))
      (begin (display "RESULT: FAILED") (newline) (exit 1))))

;; Basic escape
(test-case "escape returns value"
  (= (call/ec (lambda (k) (k 42) 99)) 42))

;; Normal return when escape not invoked
(test-case "normal return when escape not used"
  (= (call/ec (lambda (k) 99)) 99))

;; Escape from nested computation
(test-case "escape from nested expression"
  (= (call/ec (lambda (k) (+ 1 (k 10)))) 10))

;; call-with-escape-continuation full name
(test-case "full name works"
  (= (call-with-escape-continuation (lambda (k) (k 5))) 5))

;; Escape with string
(test-case "escape with string value"
  (equal? (call/ec (lambda (k) (k "found"))) "found"))

;; Escape with boolean
(test-case "escape with boolean"
  (equal? (call/ec (lambda (k) (k #t))) #t))

;; List search with early exit
(test-case "early exit from fold"
  (= (call/ec
       (lambda (return)
         (fold-left
           (lambda (acc x)
             (if (= x 3) (return x) (+ acc x)))
           0
           '(1 2 3 4 5))))
     3))

;; ============================================================================
;; call/cc tests
;; ============================================================================

(test-case "call/cc basic escape"
  (= (+ 1 (call/cc (lambda (k) (+ 2 (k 10))))) 11))

(test-case "call/cc normal return"
  (= (call/cc (lambda (k) 42)) 42))

(test-case "call/cc with string"
  (equal? (call/cc (lambda (k) (k "hello"))) "hello"))

(test-case "call-with-current-continuation full name"
  (= (call-with-current-continuation (lambda (k) (k 7))) 7))

;; ============================================================================
;; dynamic-wind tests
;; ============================================================================

(test-case "dynamic-wind basic"
  (let ((log '()))
    (dynamic-wind
      (lambda () (set! log (cons 'before log)))
      (lambda () (set! log (cons 'body log)))
      (lambda () (set! log (cons 'after log))))
    (equal? (reverse log) '(before body after))))

(test-case "dynamic-wind returns thunk result"
  (= (dynamic-wind
       (lambda () 0)
       (lambda () 42)
       (lambda () 0))
     42))

(test-case "dynamic-wind with escape runs after"
  (let ((log '()))
    (call/cc (lambda (k)
      (dynamic-wind
        (lambda () (set! log (cons 'before log)))
        (lambda () (set! log (cons 'body log)) (k 'done))
        (lambda () (set! log (cons 'after log))))))
    (equal? (reverse log) '(before body after))))

;; ============================================================================
;; full continuation tests (re-entry)
;; ============================================================================

(test-case "the R7RS dynamic-wind example re-enters and re-fires the thunks"
  (equal? '(connect talk1 disconnect connect talk2 disconnect)
          (let ((path '()) (c #f))
            (let ((add (lambda (s) (set! path (cons s path)))))
              (dynamic-wind (lambda () (add 'connect))
                            (lambda () (add (call-with-current-continuation
                                              (lambda (c0) (set! c c0) 'talk1))))
                            (lambda () (add 'disconnect)))
              (if (< (length path) 4) (c 'talk2) (reverse path))))))

(test-case "a continuation can be re-entered several times"
  (begin
    (define %cc-count 0)
    (define %cc-k #f)
    (= 3 (begin (call/cc (lambda (k) (set! %cc-k k)))
                (set! %cc-count (+ %cc-count 1))
                (if (< %cc-count 3) (%cc-k 'again) %cc-count)))))

(test-case "the value passed on re-entry becomes the value of the call/cc"
  (begin
    (define %cc-seen '())
    (define %cc-k2 #f)
    (equal? '(1 2 3)
            (begin
              (set! %cc-seen (cons (call/cc (lambda (k) (set! %cc-k2 k) 1)) %cc-seen))
              (if (< (length %cc-seen) 3) (%cc-k2 (+ (car %cc-seen) 1)) (reverse %cc-seen))))))

(test-case "a generator built from call/cc yields each element then done"
  (begin
    (define (%make-gen lst)
      (define return #f)
      (define resume #f)
      (lambda ()
        (call/cc (lambda (r)
          (set! return r)
          (if resume
              (resume #f)
              (begin
                (for-each (lambda (x) (call/cc (lambda (next) (set! resume next) (return x)))) lst)
                (set! resume (lambda (v) (return 'done)))
                (return 'done)))))))
    (let ((g (%make-gen '(1 2 3))))
      (equal? '(1 2 3 done) (list (g) (g) (g) (g))))))

(test-case "an escape out of a native map still works"
  (eq? 'found (call/cc (lambda (k) (map (lambda (x) (if (= x 3) (k 'found) x)) '(1 2 3 4))))))

(test-case "a continuation captured in a finished native callback cannot be resumed"
  (begin
    (define %cc-stale #f)
    (map (lambda (x) (call/cc (lambda (k) (set! %cc-stale k) x))) '(1))
    (string? (try (begin (%cc-stale 5) #f) (catch e (error-object-message e))))))

(test-case "call/cc reached through apply still escapes"
  (= 41 (apply call/cc (list (lambda (k) (+ 1 (k 41)))))))

(test-case "dynamic-wind after runs when the thunk raises"
  (begin
    (define %dw-log '())
    (try (dynamic-wind (lambda () (set! %dw-log (cons 'in %dw-log)))
                       (lambda () (car 1))
                       (lambda () (set! %dw-log (cons 'out %dw-log))))
         (catch e #f))
    (equal? '(in out) (reverse %dw-log))))

(test-case "dynamic-wind passes multiple values through"
  (equal? '(1 2) (call-with-values
                   (lambda () (dynamic-wind (lambda () #f) (lambda () (values 1 2)) (lambda () #f)))
                   list)))

(test-case "leaving nested dynamic-winds by continuation runs the afters innermost first"
  (begin
    (define %dw-order '())
    (call/cc (lambda (k)
      (dynamic-wind (lambda () #f)
                    (lambda ()
                      (dynamic-wind (lambda () #f)
                                    (lambda () (k 'out))
                                    (lambda () (set! %dw-order (cons 'inner %dw-order)))))
                    (lambda () (set! %dw-order (cons 'outer %dw-order))))))
    (equal? '(inner outer) (reverse %dw-order))))

(report-summary)

;;; DIV -- Benchmark which divides by 2 using lists of n ()'s.
;;; Adapted from the Gabriel benchmark suite (Public Domain).

(define (create-n n)
  (do ((n n (- n 1))
       (a '() (cons '() a)))
      ((= n 0) a)))

(define *ll* (create-n 200))

(define (iterative-div2 l)
  (do ((l l (cddr l))
       (a '() (cons (car l) a)))
      ((null? l) a)))

(define (recursive-div2 l)
  (cond ((null? l) '())
        (else (cons (car l) (recursive-div2 (cddr l))))))

(define (test-iterative l)
  (do ((i 3000 (- i 1)))
      ((= i 0))
    (iterative-div2 l)
    (iterative-div2 l)
    (iterative-div2 l)
    (iterative-div2 l)))

(define (test-recursive l)
  (do ((i 3000 (- i 1)))
      ((= i 0))
    (recursive-div2 l)
    (recursive-div2 l)
    (recursive-div2 l)
    (recursive-div2 l)))

(let* ((start (current-time-ms))
       (result (let loop ((n 10) (v 0))
                 (if (zero? n)
                     v
                     (loop (- n 1)
                           (cons (test-iterative *ll*)
                                 (test-recursive *ll*))))))
       (elapsed (- (current-time-ms) start)))
  (display "div: ")
  (display elapsed)
  (display "ms  result: done")
  (newline))

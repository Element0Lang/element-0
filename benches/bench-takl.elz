;;; TAKL -- The TAKeuchi function using lists as counters.
;;; Adapted from the Gabriel benchmark suite (Public Domain).

(define (listn n)
  (if (not (= 0 n))
      (cons n (listn (- n 1)))
      '()))

(define l18l (listn 18))
(define l12l (listn 12))
(define l6l  (listn 6))

(define (shorterp x y)
  (and (not (null? y))
       (or (null? x)
           (shorterp (cdr x) (cdr y)))))

(define (mas x y z)
  (if (not (shorterp y x))
      z
      (mas (mas (cdr x) y z)
           (mas (cdr y) z x)
           (mas (cdr z) x y))))

(let* ((start (current-time-ms))
       (result (mas l18l l12l l6l))
       (elapsed (- (current-time-ms) start)))
  (display "takl: ")
  (display elapsed)
  (display "ms  result: ")
  (display (length result))
  (newline))
